#!/bin/bash
# Change the ops dashboard password. Usage: set-ops-password 'new-password'
set -e
if [ -z "$1" ]; then
  echo "usage: set-ops-password 'new-password'" >&2
  exit 1
fi
python3 - "$1" << 'PYEOF'
import hashlib, os, secrets, sys
pw = sys.argv[1]
salt = secrets.token_bytes(16)
derived = hashlib.scrypt(pw.encode(), salt=salt, n=16384, r=8, p=1)
path = "/root/ops-dashboard/.ops_password_hash"
with open(path, "w") as f:
    f.write(f"{salt.hex()}${derived.hex()}")
os.chmod(path, 0o600)
print("password updated")
PYEOF
systemctl restart ops-auth.service 2>/dev/null || true
echo "done — new password active everywhere immediately"
