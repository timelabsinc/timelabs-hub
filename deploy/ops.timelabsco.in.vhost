# ops.timelabsco.in — HTTP: ACME renewal passthrough + redirect everything else to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ops.timelabsco.in;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ops.timelabsco.in — HTTPS, Google-login version.
# The password path (/ops-auth-check, @ops_login_redirect -> /ops/login)
# is left in place below, unused, as a fast rollback: point auth_request
# back at it and remove the oauth2 locations to undo this step.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ops.timelabsco.in;
    http2 on;

    ssl_certificate     /etc/letsencrypt/live/ops.timelabsco.in-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ops.timelabsco.in-0001/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:MozSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 50m;

    root /var/www/html;

    # bare domain -> Hub (nobody should need to know to type /ops)
    location = / {
        auth_request /oauth2/auth;
        error_page 401 = @oauth2_signin;
        auth_request_set $root_email $upstream_http_x_auth_request_email;
        proxy_pass http://127.0.0.1:8901/access/home;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-User-Email $root_email;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # --- Drop public share links: token IS the auth, deliberately no login ---
    location /s/ {
        proxy_pass http://127.0.0.1:8903;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;           # stream video without spooling to disk
        proxy_read_timeout 300s;
    }

    # --- Board reference shares: token IS the auth, same trade as /s/ above.
    # X-User-Email is cleared explicitly: this location does not run the auth
    # gate, so without this an outsider could assert the header themselves and
    # the backend would read it as a signed-in identity.
    location /rb/ {
        proxy_pass http://127.0.0.1:8901;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-User-Email "";
        proxy_read_timeout 60s;
    }

    # --- Drop (Timelabs file tunnel: custom UI + chunked API), behind Key ---
    location = /drop { return 301 /drop/; }

    # the single-page UI (directory alias + index — an alias to a file here
    # makes nginx append the index name to it and 500)
    location /drop/ {
        auth_request /labs-access-gate;
        error_page 401 = @oauth2_signin;
        error_page 403 = @labs_home_redirect;
        auth_request_set $labs_home $upstream_http_x_labs_home;
        alias /var/www/drop/;
        index index.html;
        add_header Cache-Control "no-cache" always;
    }

    # chunked upload / listing / thumbnail API -> drop_server.py
    location /drop/api/ {
        auth_request /labs-access-gate;
        error_page 401 = @oauth2_signin;
        error_page 403 = @labs_home_redirect;
        auth_request_set $email $upstream_http_x_labs_email;
        auth_request_set $labs_home $upstream_http_x_labs_home;
        proxy_set_header X-User-Email $email;

        proxy_pass http://127.0.0.1:8903/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        client_max_body_size   32m;    # one 6 MB chunk + headroom
        proxy_request_buffering off;   # stream chunks straight through
        proxy_read_timeout     300s;   # per-chunk, not per-file — chunks are small
        proxy_send_timeout     300s;
    }

    # never expose Drop's internal dirs (.uploads/.thumbs/.trash)
    location ~ ^/drop/files/\. { return 404; }

    # downloads + video streaming straight from disk (nginx handles Range)
    location /drop/files/ {
        auth_request /labs-access-gate;
        error_page 401 = @oauth2_signin;
        error_page 403 = @labs_home_redirect;
        auth_request_set $labs_home $upstream_http_x_labs_home;
        alias /srv/timelabs-drop/;
        disable_symlinks on;
        add_header Cache-Control "private, max-age=3600" always;
        types {
            image/jpeg jpg jpeg;
            image/png png;
            image/webp webp;
            image/gif gif;
            video/mp4 mp4;
            video/quicktime mov;
            video/webm webm;
            audio/mpeg mp3;
            audio/mp4 m4a;
            audio/wav wav;
        }
        default_type application/octet-stream;
        add_header X-Content-Type-Options nosniff always;
    }

    # --- old password gate: kept, unused, for rollback ---
    location = /ops-auth-check {
        internal;
        proxy_pass http://127.0.0.1:8899/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }
    location @ops_login_redirect {
        return 302 /ops/login;
    }
    # Legacy password pages now bounce into the Google flow — the old page kept
    # asking for a password via browser autocomplete (2026-07-21, Schezan).
    # Break-glass rollback: restore the two proxy_pass 8899 blocks from a .bak.
    location /ops/login { return 302 /oauth2/start?rd=/ops/; }
    location /ops/reset { return 302 /oauth2/start?rd=/ops/; }

    # --- oauth2-proxy: the live gate ---
    location /oauth2/ {
        proxy_pass       http://127.0.0.1:4180;
        proxy_set_header Host                    $host;
        proxy_set_header X-Real-IP               $remote_addr;
        proxy_set_header X-Scheme                $scheme;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
    }

    location = /oauth2/auth {
        internal;
        proxy_pass        http://127.0.0.1:4180;
        proxy_set_header  Host           $host;
        proxy_set_header  X-Real-IP      $remote_addr;
        proxy_set_header  X-Scheme       $scheme;
        proxy_set_header  Content-Length "";
        proxy_pass_request_body off;
    }

    # OAuth plus the Labs role/path check. nginx cannot nest auth_request
    # subrequests, so the loopback gate validates the oauth2-proxy cookie and
    # then applies the role/path policy in one request.
    location = /labs-access-gate {
        internal;
        proxy_pass http://127.0.0.1:8901/access/gate;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
        proxy_set_header X-Original-URI $request_uri;
    }

    location @oauth2_signin {
        return 302 /oauth2/start?rd=$request_uri;
    }

    location @labs_home_redirect {
        return 302 $labs_home;
    }

    location /ops {
        alias /var/www/ops;
        auth_request /labs-access-gate;
        error_page 401 = @oauth2_signin;
        error_page 403 = @labs_home_redirect;
        # Compatibility for the generated rollback map in labs-access.conf.
        # The live gate below no longer consumes it, but declaring the source
        # variable keeps both this vhost and the retained rollback config valid.
        auth_request_set $labs_email $upstream_http_x_labs_email;
        auth_request_set $labs_home $upstream_http_x_labs_home;
    }

    location /intake/ {
        auth_request /labs-access-gate;
        error_page 401 = @oauth2_signin;
        error_page 403 = @labs_home_redirect;
        auth_request_set $labs_home $upstream_http_x_labs_home;
        alias /var/www/intake/;
        index index.html;
    }

    location /ops/agent/api/ {
        auth_request /oauth2/auth;
        error_page 401 = @oauth2_signin;
        auth_request_set $email $upstream_http_x_auth_request_email;
        proxy_set_header X-User-Email $email;
        proxy_pass http://127.0.0.1:8901/;
        proxy_read_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /ops/refresh {
        auth_request /labs-access-gate;
        error_page 401 = @oauth2_signin;
        error_page 403 = @labs_home_redirect;
        auth_request_set $labs_home $upstream_http_x_labs_home;
        proxy_pass http://127.0.0.1:8877/refresh;
        proxy_read_timeout 270s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
